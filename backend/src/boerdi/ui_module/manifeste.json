  {
    "name": "ui_themenbaum",
    "version": 1,
    "art": "anzeigen",
    "titel": {
      "de": "Themenbaum",
      "en": "Topic tree"
    },
    "beschreibung": "Zeigt NUR, was es in WLO schon gibt: die Unterthemen eines WLO-Fachportals oder einer Sammlung als aufklappbaren Baum. Den Baum holt das System: du nennst nur das Fach (subject) ODER die Sammlung (nodeId) und siehst die Themen nicht. Fuer ein Unterthema eines Fachs (z. B. Optik in Physik) die Sammlung zuerst mit search_wlo_collections finden (query = Unterthema, discipline = Fach) und ihre nodeId nennen. Hoechstens ein kurzer Begleitsatz, keine Themenliste; tiefer klappt die Person selbst auf. Eine neue Gliederung entwirft ui_strukturentwurf.",
    "wann": [
      "die Person will wissen, welche Themen oder Unterthemen es in einem Fach oder einer Sammlung gibt",
      "gefuehrtes Stoebern, z. B. 'zeig mir die Themen in Mathe' oder 'was gibt es unter Optik?'"
    ],
    "nicht_wann": [
      "eine NEUE Gliederung, die es so noch nicht gibt (entwerfen, gliedern, Unterrichtsreihe) — dafuer ui_strukturentwurf",
      "du wertest die Unterthemen selbst aus (pruefen, Luecken finden, Lernpfad bauen) — dafuer browse_collection_tree; zum Zeigen immer dieses Werkzeug",
      "die Materialien einer Sammlung (dafuer get_collection_contents)",
      "eine Suche nach Inhalten"
    ],
    "agent": true,
    "eingabe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knoten"
      ],
      "properties": {
        "titel": {
          "type": "string",
          "maxLength": 160,
          "description": "Ueberschrift: Fach oder Sammlung, deren Unterthemen der Baum zeigt; leer, wenn unbekannt."
        },
        "wurzel_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,80}$",
          "description": "Kennung der Sammlung, deren Unterthemen der Baum zeigt."
        },
        "wurzel_url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000,
          "description": "Die Sammlung der Wurzel in WLO (nur http und https); setzt das System."
        },
        "gekuerzt": {
          "type": "boolean",
          "description": "Mindestens ein Zweig hat mehr Unterthemen, als der Baum zeigt."
        },
        "wurzel_mehr": {
          "type": "boolean",
          "description": "Die erste Ebene hat mehr Unterthemen, als der Baum zeigt."
        },
        "entwurf_moeglich": {
          "type": "boolean",
          "description": "Setzt das System: der Baum darf als Strukturentwurf geoeffnet werden (Knopf 'Als Entwurf bearbeiten')."
        },
        "knoten": {
          "type": "array",
          "maxItems": 30,
          "description": "Die Unterthemen der ersten Ebene, alphabetisch; leer, wenn es keine gibt.",
          "items": {
            "$ref": "#/$defs/knoten"
