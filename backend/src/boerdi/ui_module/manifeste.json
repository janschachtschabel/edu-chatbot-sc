[
  {
    "name": "ui_entscheidung",
    "version": 1,
    "art": "abfragen",
    "titel": {
      "de": "Entscheidung",
      "en": "Choice"
    },
    "beschreibung": "Stellt der Person eine Frage mit festen Antwortmoeglichkeiten zum Anklicken, einzeln oder mehrfach, auf Wunsch mit einem Freitextfeld. Der Aufruf beendet deinen Zug. Den Begleittext (Ergebnisse dieses Zuges einordnen, falls es welche gibt) schreibst du in derselben Runde, ueber das Antwort-Werkzeug falls vorhanden, ohne Schnellantworten; nie nur einen Verweis auf das Feld. Frage und Moeglichkeiten wiederholst du nicht im Text. Hoechstens ein Auswahlfeld je Zug. Die Antwort der Person kommt im naechsten Zug als Block vor ihrer Nachricht; dann arbeitest du damit weiter, ohne erneut zu fragen.",
    "wann": [
      "du brauchst eine Entscheidung, und die Antwortmoeglichkeiten sind bekannt und ueberschaubar (2 bis 8)",
      "eine Rueckfrage, deren Antwort sonst muehsam zu tippen waere (Klassenstufe, Variante, Format)",
      "nach einer Suche oder Erklaerung ist genau eine Angabe offen, die den naechsten Schritt bestimmt (Fach, Stufe, Vorwissen, Bausteine einer Stunde)"
    ],
    "nicht_wann": [
      "offene Fragen ohne feste Moeglichkeiten — frage dann in Prosa",
      "mehr als 8 Moeglichkeiten oder Baumstrukturen",
      "um einen Schreibvorgang bestaetigen zu lassen — dafuer gibt es die Vorschau mit Bestaetigung"
    ],
    "agent": true,
    "eingabe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frage",
        "optionen"
      ],
      "properties": {
        "frage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Die Frage an die Person, ein Satz, z. B. 'Fuer welche Klassenstufe soll das Arbeitsblatt sein?'."
        },
        "optionen": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "description": "Die Antwortmoeglichkeiten in der gewuenschten Reihenfolge; jede id nur einmal.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,40}$",
                "description": "Kurze Kennung der Moeglichkeit (Kleinbuchstaben, Ziffern, _ und -), z. B. 'klasse_5_6'. Kommt in der Antwort zurueck."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Die sichtbare Beschriftung der Moeglichkeit."
              },
              "hinweis": {
                "type": "string",
                "maxLength": 200,
                "description": "Optional: eine kurze Erklaerung unter der Beschriftung."
              }
            }
          }
        },
        "mehrfach": {
          "type": "boolean",
          "description": "true: die Person darf mehrere Moeglichkeiten waehlen; sonst genau eine (Vorgabe)."
        },
        "freitext": {
          "type": "boolean",
          "description": "true: zusaetzlich ein Feld fuer eine eigene Ergaenzung (hoechstens 1000 Zeichen); Vorgabe aus."
        }
      }
    },
    "antwort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gewaehlt"
      ],
      "properties": {
        "gewaehlt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Die Kennungen (id) der gewaehlten Moeglichkeiten.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,40}$"
          }
        },
        "freitext": {
          "type": "string",
          "maxLength": 1000,
          "description": "Die eigene Ergaenzung der Person, nur wenn das Modul ein Freitextfeld zeigte."
        }
      }
    },
    "datenquelle": null,
    "faehigkeiten": [
      "antworten"
    ],
    "textfassung": {
      "vorlage": "nummerierte_liste",
      "feld": "optionen"
    },
    "darstellung": {
      "breit": false
    },
    "beispiele": [
      {
        "titel": "Einzelwahl",
        "daten": {
          "frage": "Für welche Klassenstufe soll das Arbeitsblatt sein?",
          "optionen": [
            {
              "id": "klasse_5_6",
              "label": "Klasse 5–6"
            },
            {
              "id": "klasse_7_8",
              "label": "Klasse 7–8"
            },
            {
              "id": "klasse_9_10",
              "label": "Klasse 9–10"
            }
          ]
        },
        "antwort": {
          "gewaehlt": [
            "klasse_7_8"
          ]
        }
      },
      {
        "titel": "Mehrfachwahl mit Hinweisen und Freitext",
        "daten": {
          "frage": "Welche Formate passen für deine Stunde?",
          "optionen": [
            {
              "id": "video",
              "label": "Video",
              "hinweis": "kurze Erklärfilme bis 10 Minuten"
            },
            {
              "id": "arbeitsblatt",
              "label": "Arbeitsblatt",
              "hinweis": "zum Ausdrucken"
            },
            {
              "id": "interaktiv",
              "label": "Interaktive Übung"
            }
          ],
          "mehrfach": true,
          "freitext": true
        },
        "antwort": {
          "gewaehlt": [
            "video",
            "interaktiv"
          ],
          "freitext": "Am liebsten ohne Anmeldung."
        }
      }
    ]
  },
  {
    "name": "ui_inhaltsrahmen",
    "version": 1,
    "art": "anzeigen",
    "titel": {
      "de": "Inhaltsrahmen",
      "en": "Content frame"
    },
    "beschreibung": "Zeigt ein fertiges Arbeitsergebnis als eigene Box mit Drucken und Download: Verlaufsplan, Unterrichtsreihe, Arbeitsblatt, Lernpfad, Zeugnis, Brief oder Fachtext. markdown traegt das VOLLSTAENDIGE Ergebnis — nicht zusammenfassen, nicht bloss ankuendigen. Die Prosa-Antwort daneben ist nur der Begleitsatz (ein bis zwei Saetze).",
    "wann": [
      "sobald ein Ergebnis fertig ist, im selben Zug; Rueckfragen vorher sind in Ordnung",
      "fuer erstellte Materialien, Stunden- und Lernpfad-Planungen und Texte, die man drucken oder speichern will"
    ],
    "nicht_wann": [
      "fuer Suchtreffer aus WLO — die erscheinen als Karten",
      "fuer kurze Antworten, die in einen Satz passen"
    ],
    "agent": true,
    "eingabe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titel",
        "art",
        "markdown"
      ],
      "properties": {
        "titel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Die Ueberschrift der Box, z. B. 'Unterrichtsverlaufsplan: Einfuehrung in die Optik'."
        },
        "art": {
          "type": "string",
          "enum": [
            "lernpfad",
            "ki_material",
            "edit",
            "bericht",
            "remix",
            "stundenplanung",
            "unterrichtsreihe",
            "zeugnis",
            "dokument",
            "kompendialtext",
            "volltext",
            "schreib_vorschau"
          ],
          "description": "Die Form des Ergebnisses: lernpfad (aufeinander aufbauende Materialien), ki_material (erzeugtes Arbeitsblatt, Quiz, Aufgabenset), edit (ueberarbeitete Fassung eines vorher gezeigten Inhalts), bericht (Auswertung oder Pruefzusammenfassung), remix (Zusammenstellung aus vorhandenen Inhalten), stundenplanung (Verlaufsplan fuer EINE Stunde), unterrichtsreihe (Planung ueber mehrere Stunden), zeugnis (Zeugnis oder Beurteilung), dokument (Brief oder sonstiges Schriftstueck), kompendialtext (Fachtext zu einem Gegenstand).",
          "x-nur-system": [
            "volltext",
            "schreib_vorschau"
          ]
        },
        "markdown": {
          "type": "string",
          "minLength": 1,
          "description": "Das vollstaendige Ergebnis als Markdown (Ueberschriften, Listen, Tabellen, Links)."
        }
      }
    },
    "datenquelle": null,
    "faehigkeiten": [
      "drucken",
      "herunterladen"
    ],
    "textfassung": {
      "vorlage": "markdown",
      "feld": "markdown"
    },
    "darstellung": {
      "breit": false
    },
    "beispiele": [
      {
        "titel": "Stundenplanung mit Tabelle",
        "daten": {
          "titel": "Unterrichtsverlaufsplan: Einführung in die Optik",
          "art": "stundenplanung",
          "markdown": "## Ziel\nDie Lernenden beschreiben, wie Licht sich ausbreitet.\n\n| Phase | Dauer | Inhalt |\n|---|---|---|\n| Einstieg | 10 min | Schattenversuch |\n| Erarbeitung | 25 min | Stationen |\n| Sicherung | 10 min | Merksatz |"
        }
      },
      {
        "titel": "Lernpfad mit Links",
        "daten": {
          "titel": "Lernpfad Bruchrechnung",
          "art": "lernpfad",
          "markdown": "1. [Brüche erkennen](https://wirlernenonline.de/)\n2. Brüche kürzen\n3. Brüche addieren"
        }
      },
      {
        "titel": "Vorgeschlagene Änderung",
        "daten": {
          "titel": "Änderung an „Optik – Arbeitsblatt“",
          "art": "schreib_vorschau",
          "markdown": "- **Titel:** Optik – Arbeitsblatt 2\n- **Fach:** Physik"
        }
      }
    ]
  },
  {
    "name": "ui_linkbox",
    "version": 1,
    "art": "anzeigen",
    "titel": {
      "de": "Webseiten-Inhalte",
      "en": "Web page contents"
    },
    "beschreibung": "Zeigt die Webseiten, auf die sich die Antwort stuetzt, als Liste von Links — ohne WLO-Inhalte (die stehen in der Trefferliste). Entsteht automatisch aus den Links der Antwort.",
    "wann": [
      "automatisch, wenn die Antwort Webseiten nennt"
    ],
    "nicht_wann": [
      "fuer WLO-Inhalte und Sammlungen — dafuer die Trefferliste"
    ],
    "agent": false,
    "eingabe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "links"
      ],
      "properties": {
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "description": "Die Links in der Reihenfolge der Antwort.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "titel",
              "url"
            ],
            "properties": {
              "titel": {
                "type": "string",
                "maxLength": 300,
                "description": "Beschriftung des Links; leer, wenn die Antwort keine nennt."
              },
              "url": {
                "type": "string",
                "pattern": "^https?://",
                "maxLength": 2000,
                "description": "Adresse der Webseite (nur http und https)."
              }
            }
          }
        }
      }
    },
    "datenquelle": null,
    "faehigkeiten": [
      "oeffnen"
    ],
    "textfassung": {
      "vorlage": "link_liste",
      "feld": "links"
    },
    "darstellung": {
      "breit": false,
      "platz": "unten"
    },
    "beispiele": [
      {
        "titel": "Zwei Webseiten",
        "daten": {
          "links": [
            {
              "titel": "WirLernenOnline",
              "url": "https://wirlernenonline.de/"
            },
            {
              "titel": "Bildungsserver",
              "url": "https://www.bildungsserver.de/"
            }
          ]
        }
      },
      {
        "titel": "Link ohne Beschriftung",
        "daten": {
          "links": [
            {
              "titel": "",
              "url": "https://example.org/seite"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "ui_strukturentwurf",
    "version": 1,
    "art": "abfragen",
    "titel": {
      "de": "Strukturentwurf",
      "en": "Structure draft"
    },
    "beschreibung": "Entwirft eine NEUE Gliederung (Themenbaum), die es so in WLO noch nicht gibt — etwa fuer eine Unterrichtsreihe, eine neue Sammlung oder ein Thema ohne WLO-Sammlung. Du nennst nur den Auftrag; das System erzeugt die Ebenen von oben nach unten (je Punkt Titel, Beschreibung, Schlagworte). Die Person bearbeitet den Entwurf im Chat (umbenennen, ergaenzen, loeschen, verschieben, ein- und ausruecken), laedt ihn herunter oder uebernimmt ihn; ihr Stand kommt im naechsten Zug zurueck. Beendet deinen Zug: den kurzen Begleitsatz in derselben Runde ueber respond_to_user, keine Aufzaehlung.",
    "wann": [
      "die Person will eine neue Gliederung: 'entwirf', 'gliedere', 'neue Struktur', 'Unterrichtsreihe', 'Sammlung aufbauen zu Thema X'",
      "ein Thema ohne WLO-Sammlung soll gegliedert werden",
      "einen mitgeschickten Entwurf vertiefen (vorlage, vertiefen)"
    ],
    "nicht_wann": [
      "zeigen, was es in WLO schon gibt — Themen eines Fachportals oder einer Sammlung (dafuer ui_themenbaum)",
      "'Themenbaum fuer <Fachportal oder Sammlung>' ohne Wunsch nach etwas Neuem (ui_themenbaum, danach Entwurf anbieten)",
      "Material suchen oder einen Lernpfad aus vorhandenem Material bauen",
      "ein fertiges Dokument (ui_inhaltsrahmen)"
    ],
    "agent": true,
    "dienst": {
      "name": "strukturentwurf",
      "parameter": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thema"
        ],
        "properties": {
          "thema": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "pattern": "\\S",
            "description": "Thema der neuen Gliederung, z. B. 'Optik in Klasse 8' oder 'Unterrichtsreihe Klimawandel'."
          },
          "fach": {
            "type": "string",
            "maxLength": 60,
            "description": "Fach als Klartext (z. B. 'Physik'), nur wenn genannt oder eindeutig."
          },
          "bildungsstufe": {
            "type": "string",
            "maxLength": 60,
            "description": "Bildungsstufe als WLO-Label (Elementarbereich, Primarstufe, Sekundarstufe I, Sekundarstufe II, Berufliche Bildung, Hochschule, Erwachsenenbildung, Fortbildung), nur wenn genannt oder eindeutig; Klasse 1-4 = Primarstufe, 5-10 = Sekundarstufe I, 11-13 = Sekundarstufe II."
          },
          "anzahl_oben": {
            "type": "integer",
            "minimum": 5,
            "maximum": 20,
            "description": "Punkte auf der oberen Ebene, 5-20; ohne Angabe 10. Nach den Anforderungen der Person."
          },
          "tiefe": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "Ebenen, 1-3; ohne Angabe 2. 3 nur fuer eine feine Gliederung; nicht jeder Punkt bekommt alle Ebenen."
          },
          "hinweise": {
            "type": "string",
            "maxLength": 600,
            "description": "Wuensche der Person zur Gliederung: Schwerpunkte, Reihenfolge, was fehlen oder vorkommen soll."
          },
          "vorlage": {
            "type": "boolean",
            "description": "true: den Entwurf aus [ENTWURF DER PERSON] (mit dieser Nachricht geschickt) oder [DEIN LETZTER ENTWURF] als Grundlage nehmen — seine Punkte bleiben, es wird nur vertieft (oder mit erneut_zeigen unveraendert gezeigt)."
          },
          "erneut_zeigen": {
            "type": "boolean",
            "description": "Nur mit vorlage: den Entwurf unveraendert erneut als bearbeitbares Feld zeigen (ohne neue Punkte), etwa wenn die Person weiter bearbeiten will."
          },
          "vertiefen": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "description": "Nur mit vorlage: Titel der Punkte (wie im Entwurf), die Unterthemen bekommen sollen; ohne Angabe alle Punkte ohne Unterthemen."
          }
        }
      }
    },
    "eingabe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titel",
        "quelle",
        "knoten"
      ],
      "properties": {
        "titel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Titel des Entwurfs."
        },
        "quelle": {
          "enum": [
            "ki",
            "wlo"
          ],
          "description": "ki: von der KI erzeugt; wlo: aus einer WLO-Sammlung uebernommen (Bruecke im Themenbaum)."
        },
        "thema": {
          "type": "string",
          "maxLength": 200,
          "description": "Das Thema des Auftrags."
        },
        "fach": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Fach des Entwurfs, falls erkannt."
        },
        "bildungsstufe": {
          "$ref": "#/$defs/stufe"
        },
        "wurzel_wlo_id": {
          "$ref": "#/$defs/wlo_id"
        },
        "gekuerzt": {
          "type": "boolean",
          "description": "Die WLO-Sammlung hatte mehr Punkte, als der Entwurf uebernommen hat."
        },
        "knoten": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/ebene1"
          },
          "description": "Die Punkte der oberen Ebene."
        }
      },
      "$defs": {
        "stufe": {
          "enum": [
            "Elementarbereich",
            "Primarstufe",
            "Sekundarstufe I",
            "Sekundarstufe II",
            "Berufliche Bildung",
            "Hochschule",
            "Erwachsenenbildung",
            "Fortbildung"
          ],
          "description": "Bildungsstufe (WLO-Label), nur wenn erkannt."
        },
        "wlo_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "Kennung der WLO-Sammlung, aus der der Punkt stammt."
        },
        "felder": {
          "type": "object",
          "required": [
            "id",
            "titel"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,40}$",
              "description": "Stabile Kennung des Punkts im Entwurf."
            },
            "titel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Titel des Punkts."
            },
            "beschreibung": {
              "type": "string",
              "maxLength": 300,
              "description": "Kurzer Beschreibungstext."
            },
            "keywords": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "description": "Schlagworte."
            },
            "fach": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Fach, nur wenn es vom Entwurf abweicht."
            },
            "bildungsstufe": {
              "$ref": "#/$defs/stufe"
            },
            "wlo_id": {
              "$ref": "#/$defs/wlo_id"
            },
            "ausstehend": {
              "type": "boolean",
              "description": "Unterthemen sind vorgesehen, aber (noch) nicht erzeugt."
            }
          }
        },
        "ebene4": {
          "$ref": "#/$defs/felder",
          "unevaluatedProperties": false
        },
        "ebene3": {
          "$ref": "#/$defs/felder",
          "properties": {
            "kinder": {
              "type": "array",
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/ebene4"
              },
              "description": "Unterpunkte."
            }
          },
          "unevaluatedProperties": false
        },
        "ebene2": {
          "$ref": "#/$defs/felder",
          "properties": {
            "kinder": {
              "type": "array",
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/ebene3"
              },
              "description": "Unterpunkte."
            }
          },
          "unevaluatedProperties": false
        },
        "ebene1": {
          "$ref": "#/$defs/felder",
          "properties": {
            "kinder": {
              "type": "array",
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/ebene2"
              },
              "description": "Unterpunkte."
            }
          },
          "unevaluatedProperties": false
        }
      }
    },
    "antwort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titel",
        "quelle",
        "knoten",
        "uebernommen",
        "bearbeitet"
      ],
      "properties": {
        "titel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Titel des Entwurfs."
        },
        "quelle": {
          "enum": [
            "ki",
            "wlo"
          ],
          "description": "Herkunft wie in der Eingabe."
        },
        "thema": {
          "type": "string",
          "maxLength": 200,
          "description": "Das Thema des Auftrags."
        },
        "fach": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Fach des Entwurfs."
        },
        "bildungsstufe": {
          "$ref": "#/$defs/stufe"
        },
        "wurzel_wlo_id": {
          "$ref": "#/$defs/wlo_id"
        },
        "gekuerzt": {
          "type": "boolean",
          "description": "Wie in der Eingabe."
        },
        "knoten": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/ebene1"
          },
          "description": "Der Stand der Person."
        },
        "uebernommen": {
          "type": "boolean",
          "description": "true: die Person hat 'Uebernehmen' gewaehlt; false: der Stand ging mit einer getippten Nachricht mit."
        },
        "bearbeitet": {
          "type": "boolean",
          "description": "Die Person hat den Entwurf veraendert."
        }
      },
      "$defs": {
        "stufe": {
          "enum": [
            "Elementarbereich",
            "Primarstufe",
            "Sekundarstufe I",
            "Sekundarstufe II",
            "Berufliche Bildung",
            "Hochschule",
            "Erwachsenenbildung",
            "Fortbildung"
          ],
          "description": "Bildungsstufe (WLO-Label)."
        },
