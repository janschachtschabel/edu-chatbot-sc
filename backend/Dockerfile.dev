# Dev image (P0-7): dependencies baked in, source bind-mounted for --reload.
# Non-root from day 1 (improvement V12). Dependency changes need a rebuild.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.7 /uv /uvx /usr/local/bin/

RUN useradd --create-home --uid 1000 boerdi
USER boerdi
WORKDIR /app

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/home/boerdi/.venv \
    PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1

COPY --chown=boerdi:boerdi pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project --no-dev

EXPOSE 8100
CMD ["uv", "run", "--no-sync", "uvicorn", "boerdi.main:app", \
     "--host", "0.0.0.0", "--port", "8100", "--reload"]
