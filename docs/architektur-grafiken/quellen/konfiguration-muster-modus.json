 "cards": [
  {
   "dot": "cyan",
   "title": "Lesehilfe",
   "items": [
    "Mitte: die Schritte eines Zuges; ein Pfeil führt von der Einstellung zum Schritt, in dem sie wirkt",
    "Oben: Studio-Bereiche in Postgres – sie gelten ohne Neustart, nur die Guide-Regeln brauchen einen",
    "Unten: Umgebungsvariablen des Betriebs (Neustart) und Attribute der Einbettung (je Anfrage)",
    "Nicht gezeichnet: RATE_LIMIT_CHAT (HTTP 429) und das Attribut device (Trefferzahl je Gerät)"
   ]
  },
  {
   "dot": "emerald",
   "title": "Das Muster als Hauptschalter",
   "items": [
    "20 Muster M01–M20: die Klassifikation liefert einen Hinweis, die Musterwahl entscheidet, Schutzmuster zuerst",
    "Ein Muster legt Werkzeuge, Ton, Länge, Ausgabeform, Quellen und den Schnellantwort-Modus fest",
    "Persona-Ton und Signale verschieben Ton und Länge; die Geräte-Regel setzt die Trefferzahl (Seed: 4)",
    "Wissen aus RAG nur in Mustern mit eigener Bereichsliste – im Seed M04 und M15"
   ]
  },
  {
   "dot": "amber",
   "title": "Schnellantworten",
   "items": [
    "Anzahl und Länge aus den Anzeige-Regeln (Seed: 2 Chips, höchstens 48 Zeichen)",
    "CHAT_INLINE_QUICK_REPLIES (Vorgabe an): der Antwort-Aufruf liefert sie mit, sonst ein eigener Aufruf",
    "Host-Chips ersetzen sie; mit quick_replies_max füllt das Modell die übrigen Plätze",
    "M01 und M02 zeigen keine Schnellantworten"
   ]
  },
  {
   "dot": "slate",
   "title": "Fest im Code",
   "items": [
    "Verlauf: 20 Nachrichten geladen, die letzten 10 gehen in den Prompt",
    "Werkzeugschleife: höchstens 5 Runden",
    "Regex-Krisenerkennung vor jeder Einstellung (→ M01/M02)",
    "Nur im Agent-Modus: Master-Skill, tool_mode, result_schema"
   ]
  }
 ]
