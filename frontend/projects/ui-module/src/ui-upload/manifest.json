    "properties": {
      "aktion": {
        "enum": [
          "erfasst",
          "ordner_als_entwurf",
          "dokument",
          "uebertragen"
        ],
        "description": "erfasst: nur der Befund; ordner_als_entwurf: die Ordnerstruktur als Themenbaum-Entwurf uebernehmen; dokument: das Dokument wurde gelesen (Feld dokument), die Person will damit weiterarbeiten (ziel). uebertragen: die Dateien wurden in den persoenlichen Bereich in WLO uebertragen (Feld ablage)."
      },
      "struktur": {
        "$ref": "#/$defs/ordner1",
        "description": "Der erfasste Ordnerbaum (Wurzel + höchstens 8 Ebenen, höchstens 500 Ordner)."
      },
      "zahlen": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordner",
          "dateien",
          "inhalte",
          "ignoriert",
          "strukturdokumente",
          "bytes"
        ],
        "description": "Zahlen der Erfassung.",
        "properties": {
          "ordner": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Zahl der Ordner."
          },
          "dateien": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Alle erfassten Dateien."
          },
          "inhalte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Dateien mit der Rolle Inhalt."
          },
          "ignoriert": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Ignorierte Dateien."
          },
          "strukturdokumente": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "description": "Markierte Strukturdokumente (hoechstens eins)."
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Groesse aller nicht ignorierten Dateien."
          }
        }
      },
      "strukturdokument": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "groesse",
              "endung"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^\\n\\r]*$",
                "description": "Dateiname des Strukturdokuments."
              },
              "groesse": {
                "type": "integer",
                "minimum": 0,
                "description": "Groesse in Bytes."
              },
              "endung": {
                "enum": [
                  "pdf",
                  "docx",
                  "txt",
                  "md"
                ],
                "description": "Dateiendung."
              }
            }
          }
        ],
        "description": "Das markierte Strukturdokument oder null."
      },
      "warnungen": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "enum": [
            "zu_viele",
            "zu_tief",
            "zu_gross",
            "leer",
            "ungueltiger_pfad",
            "zu_viele_ordner"
          ]
        },
        "description": "Was beim Erfassen weggefallen ist."
      },
      "dokument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upload_id",
          "name",
          "format",
          "ziel",
          "befund",
          "vorschau"
        ],
        "description": "Nur mit aktion dokument: was das System beim Lesen festgestellt hat (kein Text des Dokuments).",
        "properties": {
          "upload_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "Kennung des gelesenen Dokuments (POST /api/ui/dokumente)."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\n\r]*$",
            "description": "Name des Dokuments."
          },
          "format": {
            "enum": [
              "pdf",
              "docx",
              "txt",
              "md"
            ],
            "description": "Erkannte Art."
          },
          "ziel": {
            "enum": [
              "themenbaum"
            ],
            "description": "Was die Person mit dem Dokument tun will: themenbaum = einen Themenbaum-Entwurf daraus."
          },
          "befund": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seiten",
              "woerter",
              "abschnitte",
              "gliederung_art",
              "warnungen"
            ],
            "properties": {
              "seiten": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                ],
                "description": "Seiten (nur PDF)."
              },
              "woerter": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000,
                "description": "Woerter."
              },
              "abschnitte": {
                "type": "integer",
                "minimum": 0,
                "maximum": 400,
                "description": "Abschnitte der Gliederung."
              },
              "gliederung_art": {
                "enum": [
                  "ueberschriften",
                  "nummeriert",
                  "teile"
                ],
                "description": "Woran gegliedert wurde."
              },
              "warnungen": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "enum": [
                    "bilder_entfernt",
                    "wenig_text",
                    "keine_gliederung",
                    "gekuerzt"
                  ]
                },
                "description": "Hinweise beim Lesen."
              }
            }
          },
          "vorschau": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\n\r]*$"
            },
            "description": "Die ersten Ueberschriften des Dokuments."
          }
        }
      },
      "ablage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layout",
          "gesamt",
          "abgelegt",
          "unklar",
          "fehler",
          "abgebrochen",
          "ordner_verweigert",
          "vorgang_abgelegt"
        ],
        "description": "Nur mit aktion uebertragen: nur Zahlen, keine Kennungen und keine Dateinamen.",
        "properties": {
          "layout": {
            "enum": [
              "ordner",
              "flach"
            ],
            "description": "ordner: in einem eigenen Ordner; flach: direkt im persoenlichen Bereich."
          },
          "gesamt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200,
            "description": "Dateien in der Freigabe."
          },
          "abgelegt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200,
            "description": "Abgelegt (auch: Knoten da, Inhalt verworfen)."
          },
          "unklar": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200,
            "description": "Ohne Antwort - koennen abgelegt sein."
          },
          "fehler": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200,
            "description": "Nicht abgelegt."
          },
          "abgebrochen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200,
            "description": "Nicht gesendet (abgebrochen)."
          },
          "ordner_verweigert": {
            "type": "boolean",
            "description": "Der Ordner durfte nicht angelegt werden; die Dateien liegen flach."
          },
          "vorgang_abgelegt": {
            "type": "boolean",
            "description": "vorgang.json liegt im Ordner."
          }
        }
      }
    }
  },
  "datenquelle": null,
  "vorgang": {
    "schreibt": [
