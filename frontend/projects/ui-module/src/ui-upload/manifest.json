{
  "name": "ui_upload",
  "version": 1,
  "art": "abfragen",
  "titel": {
    "de": "Ordner und Dateien",
    "en": "Folders and files"
  },
  "beschreibung": "Laesst die Person einen Ordner (oder einzelne Dateien) auswaehlen oder ablegen und zeigt ihn als Baum mit Dateizahlen. Danach waehlt sie, wo verarbeitet wird: hier im Chat (begrenzt, liest Inhalte und Strukturdokumente), in WLO (angemeldet, mit Erschliessung) oder nur die Namen. Das Feld stellt nur bereit und kennt kein Ziel: was damit geschieht, klaerst du danach oder ein Ablauf. Zurueck kommen Ordner- und Dateinamen mit Zahlen (du siehst nur eine Zusammenfassung), nie Inhalte; Gelesenes liegt im Vorgang.",
  "wann": [
    "die Person will eigene Ordner, Dateien oder ein Dokument (etwa einen Lehrplan) einbringen",
    "die Person will einen Ordner mit Dateien einbringen, sichten oder ordnen",
    "die Person fragt, ob sie Dateien oder einen Ordner hochladen kann"
  ],
  "nicht_wann": [
    "ein Thema ohne eigene Dateien gliedern (dafuer ui_strukturentwurf)",
    "zeigen, was es in WLO schon gibt (dafuer ui_themenbaum)",
    "ein einzelnes Bild ansehen oder beschreiben lassen"
  ],
  "agent": true,
  "laden": "bei_bedarf",
  "dienst": {
    "name": "upload_angebot",
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zweck"
      ],
      "properties": {
        "zweck": {
          "enum": [
            "bereitstellen",
            "sammlungsstruktur"
          ],
          "description": "bereitstellen: Ordner, Dateien oder ein Dokument bereitstellen, ohne Ziel (Vorgabe). sammlungsstruktur: aelterer Wert, bleibt gueltig; ein passender Ablauf geht dann vor."
        },
        "hinweis": {
          "type": "string",
          "maxLength": 300,
          "description": "Kurzer Satz an die Person, was sie auswaehlen soll (z. B. 'Waehle den Ordner mit deinen Physik-Materialien.')."
        },
        "einzeldatei_als_struktur": {
          "type": "boolean",
          "description": "Eine einzeln gewaehlte Datei (PDF, Word, Text, Markdown) gleich als Strukturdokument vormerken — fuer Ablaeufe, die ein einzelnes Dokument erwarten. Sonst bleibt sie Inhalt."
        },
        "orte": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chat",
              "wlo",
              "namen"
            ]
          },
          "description": "Nur aus einem Ablauf: welche Orte das Feld anbieten darf (chat, wlo, namen). Ohne Angabe alle; namen bleibt immer."
        }
      }
    }
  },
  "eingabe": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "zweck"
    ],
    "properties": {
      "zweck": {
        "enum": [
          "bereitstellen",
          "sammlungsstruktur"
        ],
        "description": "Wozu erfasst wird: bereitstellen (ohne Ziel); sammlungsstruktur ist der aeltere Wert (Rueckwaerts)."
      },
      "hinweis": {
        "type": "string",
        "maxLength": 300,
        "description": "Satz an die Person ueber dem Auswahlfeld."
      },
      "grenzen": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "description": "Grenzen fuer das Erfassen (setzt das System).",
        "properties": {
          "max_dateien": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "description": "Hoechstzahl erfasster Dateien."
          },
          "max_tiefe": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Hoechste Ordnertiefe."
          },
          "max_mb_datei": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Groesste Datei in MB."
          },
          "max_mb_ablage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Groesste Datei in MB fuer die Ablage in WLO."
          },
          "lokal_max_dateien": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Hier im Chat: hoechstens so viele Dateien je Sitzung."
          },
          "lokal_max_mb_gesamt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Hier im Chat: hoechstens so viele MB je Sitzung."
          },
          "lokal_max_mb_datei": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Hier im Chat: groesste Datei in MB."
          },
          "lokal_aufbewahrung_h": {
            "type": "integer",
            "minimum": 1,
            "maximum": 72,
            "description": "Hier im Chat: so viele Stunden bleibt der Text nach letzter Nutzung (Studio aufbewahrung_h); die Oberflaeche nennt es."
          },
          "lokal_frei_dateien": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30,
            "description": "Hier im Chat: so viele Dateien darf die Sitzung noch (lokal_max_dateien minus nicht abgelaufene Uploads; Review U, MAJOR 3). Fehlt: nicht gezaehlt."
          },
          "lokal_frei_mb": {
            "type": "number",
            "minimum": 0,
            "maximum": 200,
            "description": "Hier im Chat: so viele MB darf die Sitzung noch (abgerundet auf 0,1). Fehlt: nicht gezaehlt."
          }
        }
      },
      "schalter": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "description": "Was im Studio eingeschaltet ist (setzt das System).",
        "properties": {
          "dokument_im_chat": {
            "type": "boolean",
            "description": "Darf ein Dokument im Chat gelesen werden."
          },
          "lesen_nach_anmeldung": {
            "type": "boolean",
            "description": "Ein Dokument liesse sich nach der WLO-Anmeldung lesen (R3-b)."
          },
          "ablage_in_wlo": {
            "type": "boolean",
            "description": "Duerfen Inhalte in WLO abgelegt werden."
          },
          "ablage_nach_anmeldung": {
            "type": "boolean",
            "description": "Inhalte liessen sich nach der WLO-Anmeldung in WLO ablegen (Rueckmeldung 16.11.)."
          },
          "dokument_ohne_anmeldung": {
            "type": "boolean",
            "description": "Studio: Hier im Chat geht auch ohne WLO-Anmeldung (die Erklaerzeile nennt es nur dann)."
          }
        }
      },
      "einzeldatei_als_struktur": {
        "type": "boolean",
        "description": "Eine einzeln gewaehlte Datei (PDF, Word, Text, Markdown) gleich als Strukturdokument vormerken — fuer Ablaeufe, die ein einzelnes Dokument erwarten. Sonst bleibt sie Inhalt."
      },
      "orte": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "required": [
          "vorauswahl",
          "chat",
          "wlo",
          "namen"
        ],
        "description": "Wo verarbeiten? (setzt das System, Plan 2026-11-17, E13).",
        "properties": {
          "vorauswahl": {
            "enum": [
              "chat",
              "wlo",
              "namen"
            ],
            "description": "Der vorgewaehlte Ort."
          },
          "chat": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geht"
            ],
            "description": "Hier im Chat: lesen und kurz beschreiben, begrenzt.",
            "properties": {
              "geht": {
                "type": "boolean",
                "description": "Ist der Ort waehlbar."
              },
              "grund": {
                "enum": [
                  "aus",
                  "nur_angemeldet",
                  "ablauf",
                  "grenze_sitzung"
                ],
                "description": "Warum gesperrt: aus (Studio oder Dienst fehlt), nur_angemeldet (geht nach der WLO-Anmeldung), ablauf (der Ablauf laesst ihn nicht zu), grenze_sitzung (nur chat: die Sitzung haelt schon so viele Uploads, wie sie darf)."
              },
              "hinweis": {
                "enum": [
                  "ohne_erschliessung"
                ],
                "description": "Geht, aber eingeschraenkt: ohne_erschliessung = Ablage in WLO ohne Kestra-Metadaten."
              },
              "ueber_grenze": {
                "enum": [
                  "ueber_grenze",
                  "ueber_grenze_anmelden"
                ],
                "description": "Nur chat: dieser Code gilt, wenn die Auswahl die Grenzen lokal_* ueberschreitet (dann nur namen bzw. wlo); _anmelden = mit WLO-Anmeldung ginge alles ueber WLO."
              },
              "texterkennung": {
                "type": "boolean",
                "description": "Nur chat (Plan 2026-11-19, Paket C): gescannte PDF liest der Chat per Texterkennung; ihre Seiten gehen als Bild an das KI-Modell."
              }
            }
          },
          "wlo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geht"
            ],
            "description": "In WLO ablegen und erschliessen (Anmeldung, Kestra).",
            "properties": {
              "geht": {
                "type": "boolean",
                "description": "Ist der Ort waehlbar."
              },
              "grund": {
                "enum": [
                  "aus",
                  "nur_angemeldet",
                  "ablauf"
                ],
                "description": "Warum gesperrt: aus (Studio oder Dienst fehlt), nur_angemeldet (geht nach der WLO-Anmeldung), ablauf (der Ablauf laesst ihn nicht zu)."
              },
              "hinweis": {
                "enum": [
                  "ohne_erschliessung"
                ],
                "description": "Geht, aber eingeschraenkt: ohne_erschliessung = Ablage in WLO ohne Kestra-Metadaten."
              },
              "ueber_grenze": {
                "enum": [
                  "ueber_grenze",
                  "ueber_grenze_anmelden"
                ],
                "description": "Nur chat: dieser Code gilt, wenn die Auswahl die Grenzen lokal_* ueberschreitet (dann nur namen bzw. wlo); _anmelden = mit WLO-Anmeldung ginge alles ueber WLO."
              }
            }
          },
          "namen": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geht"
            ],
            "description": "Nur Namen senden, nichts hochladen.",
            "properties": {
              "geht": {
                "type": "boolean",
                "description": "Ist der Ort waehlbar."
              },
              "grund": {
                "enum": [
                  "aus",
                  "nur_angemeldet",
                  "ablauf"
                ],
                "description": "Warum gesperrt: aus (Studio oder Dienst fehlt), nur_angemeldet (geht nach der WLO-Anmeldung), ablauf (der Ablauf laesst ihn nicht zu)."
              },
              "hinweis": {
                "enum": [
                  "ohne_erschliessung"
                ],
                "description": "Geht, aber eingeschraenkt: ohne_erschliessung = Ablage in WLO ohne Kestra-Metadaten."
              },
              "ueber_grenze": {
                "enum": [
                  "ueber_grenze",
                  "ueber_grenze_anmelden"
                ],
                "description": "Nur chat: dieser Code gilt, wenn die Auswahl die Grenzen lokal_* ueberschreitet (dann nur namen bzw. wlo); _anmelden = mit WLO-Anmeldung ginge alles ueber WLO."
              }
            }
          }
        }
      }
    }
  },
