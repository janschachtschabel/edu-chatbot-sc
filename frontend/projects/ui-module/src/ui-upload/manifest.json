{
  "name": "ui_upload",
  "version": 1,
  "art": "abfragen",
  "titel": {
    "de": "Ordner und Dateien",
    "en": "Folders and files"
  },
  "beschreibung": "Laesst die Person einen Ordner (oder einzelne Dateien) auswaehlen oder ablegen und zeigt ihn als Baum mit Dateizahlen. Erfasst wird im Browser; hochgeladen wird nur, was die Person lesen laesst oder (angemeldet) nach WLO uebertraegt. Das Feld stellt nur bereit und kennt kein Ziel: was damit geschieht, klaerst du danach oder ein Ablauf. Zurueck kommen Ordner- und Dateinamen mit Zahlen (du siehst nur eine Zusammenfassung), nie Inhalte.",
  "wann": [
    "die Person will eigene Ordner, Dateien oder ein Dokument (etwa einen Lehrplan) einbringen",
    "die Person will einen Ordner mit Dateien einbringen, sichten oder ordnen",
    "die Person fragt, ob sie Dateien oder einen Ordner hochladen kann"
  ],
  "nicht_wann": [
    "ein Thema ohne eigene Dateien gliedern (dafuer ui_strukturentwurf)",
    "zeigen, was es in WLO schon gibt (dafuer ui_themenbaum)",
    "ein einzelnes Bild ansehen oder beschreiben lassen"
  ],
  "agent": true,
  "laden": "bei_bedarf",
  "dienst": {
    "name": "upload_angebot",
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zweck"
      ],
      "properties": {
        "zweck": {
          "enum": [
            "bereitstellen",
            "sammlungsstruktur"
          ],
          "description": "bereitstellen: Ordner, Dateien oder ein Dokument bereitstellen, ohne Ziel (Vorgabe). sammlungsstruktur: aelterer Wert, bleibt gueltig; ein passender Ablauf geht dann vor."
        },
        "hinweis": {
          "type": "string",
          "maxLength": 300,
          "description": "Kurzer Satz an die Person, was sie auswaehlen soll (z. B. 'Waehle den Ordner mit deinen Physik-Materialien.')."
        },
        "einzeldatei_als_struktur": {
          "type": "boolean",
          "description": "Eine einzeln gewaehlte Datei (PDF, Word, Text, Markdown) gleich als Strukturdokument vormerken — fuer Ablaeufe, die ein einzelnes Dokument erwarten. Sonst bleibt sie Inhalt."
        }
      }
    }
  },
  "eingabe": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "zweck"
    ],
    "properties": {
      "zweck": {
        "enum": [
          "bereitstellen",
          "sammlungsstruktur"
        ],
        "description": "Wozu erfasst wird: bereitstellen (ohne Ziel); sammlungsstruktur ist der aeltere Wert (Rueckwaerts)."
      },
      "hinweis": {
        "type": "string",
        "maxLength": 300,
        "description": "Satz an die Person ueber dem Auswahlfeld."
      },
      "grenzen": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "description": "Grenzen fuer das Erfassen (setzt das System).",
        "properties": {
          "max_dateien": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "description": "Hoechstzahl erfasster Dateien."
          },
          "max_tiefe": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Hoechste Ordnertiefe."
          },
          "max_mb_datei": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Groesste Datei in MB."
          },
          "max_mb_ablage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Groesste Datei in MB fuer die Ablage in WLO."
          }
        }
      },
      "schalter": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "description": "Was im Studio eingeschaltet ist (setzt das System).",
        "properties": {
          "dokument_im_chat": {
            "type": "boolean",
            "description": "Darf ein Dokument im Chat gelesen werden."
          },
          "lesen_nach_anmeldung": {
            "type": "boolean",
            "description": "Ein Dokument liesse sich nach der WLO-Anmeldung lesen (R3-b)."
          },
          "ablage_in_wlo": {
            "type": "boolean",
            "description": "Duerfen Inhalte in WLO abgelegt werden."
          },
          "ablage_nach_anmeldung": {
            "type": "boolean",
            "description": "Inhalte liessen sich nach der WLO-Anmeldung in WLO ablegen (Rueckmeldung 16.11.)."
          }
        }
      },
      "einzeldatei_als_struktur": {
        "type": "boolean",
        "description": "Eine einzeln gewaehlte Datei (PDF, Word, Text, Markdown) gleich als Strukturdokument vormerken — fuer Ablaeufe, die ein einzelnes Dokument erwarten. Sonst bleibt sie Inhalt."
      }
    }
  },
  "antwort": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "aktion",
      "struktur",
      "zahlen",
      "strukturdokument",
      "warnungen"
    ],
    "$defs": {
      "ordner1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "dateien",
          "alle_dateien",
          "kinder"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\n\\r]*$",
            "description": "Ordnername (leer bei der Auswahl mehrerer Ordner)."
          },
          "dateien": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Dateien direkt in diesem Ordner."
          },
          "alle_dateien": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Dateien samt Unterordnern."
          },
          "kinder": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/$defs/ordner2"
            },
            "description": "Unterordner."
          },
          "dateiliste": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/$defs/datei"
            },
            "description": "Dateien direkt in diesem Ordner (Plan 2026-11-16, TG-3a); fehlt bei Antworten vor TG-3a."
          }
        }
