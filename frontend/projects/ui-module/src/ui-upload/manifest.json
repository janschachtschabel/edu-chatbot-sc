{
  "name": "ui_upload",
  "version": 1,
  "art": "abfragen",
  "titel": {
    "de": "Ordner und Dateien",
    "en": "Folders and files"
  },
  "beschreibung": "Lässt die Person einen Ordner (oder einzelne Dateien) auswählen oder ablegen und zeigt ihn als Baum mit Dateizahlen. Danach wählt sie, wo verarbeitet wird: hier im Chat (begrenzt, liest Inhalte und Strukturdokumente), in WLO (angemeldet, mit Erschließung) oder nur die Namen. Das Feld stellt nur bereit und kennt kein Ziel: was damit geschieht, klärst du danach oder ein Ablauf. Zurück kommen Ordner- und Dateinamen mit Zahlen (du siehst nur eine Zusammenfassung), nie Inhalte; Gelesenes liegt im Vorgang.",
  "wann": [
    "die Person will eigene Ordner, Dateien oder ein Dokument (etwa einen Lehrplan) einbringen",
    "die Person will einen Ordner mit Dateien einbringen, sichten oder ordnen",
    "die Person fragt, ob sie Dateien oder einen Ordner hochladen kann"
  ],
  "nicht_wann": [
    "ein Thema ohne eigene Dateien gliedern (dafuer ui_strukturentwurf)",
    "zeigen, was es in WLO schon gibt (dafuer ui_themenbaum)",
    "ein einzelnes Bild ansehen oder beschreiben lassen"
  ],
  "agent": true,
  "laden": "bei_bedarf",
  "dienst": {
    "name": "upload_angebot",
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zweck"
      ],
      "properties": {
        "zweck": {
          "enum": [
            "bereitstellen",
            "sammlungsstruktur"
          ],
          "description": "bereitstellen: Ordner, Dateien oder ein Dokument bereitstellen, ohne Ziel (Vorgabe). sammlungsstruktur: älterer Wert, bleibt gültig; ein passender Ablauf geht dann vor."
        },
        "hinweis": {
          "type": "string",
          "maxLength": 300,
          "description": "Kurzer Satz an die Person, was sie auswählen soll (z. B. 'Wähle den Ordner mit deinen Physik-Materialien.')."
        },
        "einzeldatei_als_struktur": {
          "type": "boolean",
          "description": "Älterer Schalter, bleibt gültig: true heißt rolle_vorgabe gliederung (Plan 2026-11-20, P2). Neue Abläufe setzen rolle_vorgabe."
        },
        "orte": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chat",
              "wlo",
              "namen"
            ]
          },
          "description": "Nur aus einem Ablauf: welche Orte das Feld anbieten darf (chat, wlo, namen). Ohne Angabe alle; namen bleibt immer."
        },
        "vorauswahl": {
          "enum": [
            "auto",
            "wlo",
            "chat"
          ],
          "description": "Nur aus einem Ablauf: welcher Ort vorgewählt ist. auto (Vorgabe): WLO, wenn angemeldet und der Metadaten-Flow da ist, sonst Chat. wlo/chat: dieser Ort, wenn er geht, sonst auto. Im freien Chat gilt das Studio (upload-config vorauswahl)."
        },
        "rolle_vorgabe": {
          "enum": [
            "auto",
            "gliederung",
            "material",
            "beides"
          ],
          "description": "Nur aus einem Ablauf: mit welcher Rolle die Dateien beginnen. auto (Vorgabe): ein Lehrplan-Name in der Wurzel wird Gliederung, sonst Material. gliederung/beides: jede lesbare Datei (PDF, Word, Text, Markdown, höchstens 5), die übrigen Material. material: alle Material."
        },
        "erschliessen": {
          "type": "boolean",
          "description": "Nur aus einem Ablauf, der die Erschließung danach nutzt (Auftragsschritt mit zustimmung: upload): setzt der Schritt den Wert (true oder false), erscheint das Häkchen 'Metadaten von WLO erzeugen lassen' mit dieser Vorgabe; die Person kann es umstellen. Es erscheint nur, wenn der Metadaten-Flow da ist. Ohne Angabe (auch im freien Chat) kein Häkchen: der Ort heißt 'In WLO ablegen', WLO legt nur ab."
        }
      }
    }
  },
  "eingabe": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "zweck"
    ],
    "properties": {
      "zweck": {
        "enum": [
          "bereitstellen",
          "sammlungsstruktur"
        ],
        "description": "Wozu erfasst wird: bereitstellen (ohne Ziel); sammlungsstruktur ist der ältere Wert (Rückwärts)."
      },
      "hinweis": {
        "type": "string",
        "maxLength": 300,
        "description": "Satz an die Person über dem Auswahlfeld."
      },
      "grenzen": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "description": "Grenzen für das Erfassen (setzt das System).",
        "properties": {
          "max_dateien": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "description": "Höchstzahl erfasster Dateien."
          },
          "max_tiefe": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Höchste Ordnertiefe."
          },
          "max_mb_datei": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Größte Datei in MB."
          },
          "max_mb_ablage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Größte Datei in MB für die Ablage in WLO."
          },
          "lokal_max_dateien": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Hier im Chat: höchstens so viele Dateien je Sitzung."
          },
          "lokal_max_mb_gesamt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Hier im Chat: höchstens so viele MB je Sitzung."
          },
          "lokal_max_mb_datei": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Hier im Chat: größte Datei in MB."
          },
          "lokal_aufbewahrung_h": {
            "type": "integer",
            "minimum": 1,
            "maximum": 72,
            "description": "Hier im Chat: so viele Stunden bleibt der Text nach letzter Nutzung (Studio aufbewahrung_h); die Oberfläche nennt es."
          },
          "lokal_frei_dateien": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30,
            "description": "Hier im Chat: so viele Dateien darf die Sitzung noch (lokal_max_dateien minus nicht abgelaufene Uploads; Review U, MAJOR 3). Fehlt: nicht gezählt."
          },
          "lokal_frei_mb": {
            "type": "number",
            "minimum": 0,
            "maximum": 200,
            "description": "Hier im Chat: so viele MB darf die Sitzung noch (abgerundet auf 0,1). Fehlt: nicht gezählt."
          }
        }
      },
      "schalter": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "description": "Was im Studio eingeschaltet ist (setzt das System).",
        "properties": {
          "dokument_im_chat": {
            "type": "boolean",
            "description": "Darf ein Dokument im Chat gelesen werden."
          },
          "lesen_nach_anmeldung": {
            "type": "boolean",
            "description": "Ein Dokument ließe sich nach der WLO-Anmeldung lesen (R3-b)."
          },
          "ablage_in_wlo": {
            "type": "boolean",
            "description": "Dürfen Inhalte in WLO abgelegt werden."
          },
          "ablage_nach_anmeldung": {
            "type": "boolean",
            "description": "Inhalte ließen sich nach der WLO-Anmeldung in WLO ablegen (Rückmeldung 16.11.)."
          },
          "dokument_ohne_anmeldung": {
            "type": "boolean",
            "description": "Studio: Hier im Chat geht auch ohne WLO-Anmeldung (die Erklärzeile nennt es nur dann)."
          }
        }
      },
      "einzeldatei_als_struktur": {
        "type": "boolean",
        "description": "Älterer Schalter, bleibt gültig: true heißt rolle_vorgabe gliederung (Plan 2026-11-20, P2). Neue Abläufe setzen rolle_vorgabe."
      },
      "rolle_vorgabe": {
        "enum": [
          "auto",
          "gliederung",
          "material",
          "beides"
        ],
        "x-nur-system": true,
        "description": "Mit welcher Rolle die Dateien beginnen (setzt das System aus dem Ablauf-Schritt; frei: auto). auto: Lehrplan-Name in der Wurzel wird Gliederung. gliederung/beides: jede lesbare Datei bis 5, die übrigen Material. material: alle Material."
      },
      "erschliessen": {
        "type": "boolean",
        "x-nur-system": true,
        "description": "Vorgabe des Häkchens 'Metadaten von WLO erzeugen lassen' (setzt das System aus dem Ablauf-Schritt). Fehlt der Wert, gibt es kein Häkchen (nur ablegen). Gezeigt nur, wenn WLO geht und der Metadaten-Flow da ist."
      },
      "orte": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "required": [
          "vorauswahl",
          "chat",
          "wlo",
          "namen"
        ],
        "description": "Wo verarbeiten? (setzt das System, Plan 2026-11-17, E13).",
        "properties": {
          "vorauswahl": {
            "enum": [
              "chat",
              "wlo",
              "namen"
            ],
            "description": "Der vorgewählte Ort."
          },
          "chat": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geht"
            ],
            "description": "Hier im Chat: lesen und kurz beschreiben, begrenzt.",
            "properties": {
              "geht": {
                "type": "boolean",
                "description": "Ist der Ort wählbar."
              },
              "grund": {
                "enum": [
                  "aus",
                  "nur_angemeldet",
                  "ablauf",
                  "grenze_sitzung"
                ],
                "description": "Warum gesperrt: aus (Studio oder Dienst fehlt), nur_angemeldet (geht nach der WLO-Anmeldung), ablauf (der Ablauf lässt ihn nicht zu), grenze_sitzung (nur chat: die Sitzung hält schon so viele Uploads, wie sie darf)."
              },
              "hinweis": {
                "enum": [
                  "ohne_erschliessung"
                ],
                "description": "Geht, aber eingeschränkt: ohne_erschliessung = Ablage in WLO ohne Kestra-Metadaten."
              },
              "ueber_grenze": {
                "enum": [
                  "ueber_grenze",
                  "ueber_grenze_anmelden"
                ],
                "description": "Nur chat: dieser Code gilt, wenn die Auswahl die Grenzen lokal_* überschreitet (dann nur namen bzw. wlo); _anmelden = mit WLO-Anmeldung ginge alles über WLO."
              },
              "texterkennung": {
                "type": "boolean",
                "description": "Nur chat (Plan 2026-11-19, Paket C): gescannte PDF liest der Chat per Texterkennung; ihre Seiten gehen als Bild an das KI-Modell."
              }
            }
          },
          "wlo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geht"
            ],
            "description": "In WLO ablegen und erschließen (Anmeldung, Kestra).",
            "properties": {
              "geht": {
                "type": "boolean",
                "description": "Ist der Ort wählbar."
              },
              "grund": {
                "enum": [
                  "aus",
                  "nur_angemeldet",
                  "ablauf"
                ],
                "description": "Warum gesperrt: aus (Studio oder Dienst fehlt), nur_angemeldet (geht nach der WLO-Anmeldung), ablauf (der Ablauf lässt ihn nicht zu)."
              },
              "hinweis": {
                "enum": [
                  "ohne_erschliessung"
                ],
                "description": "Geht, aber eingeschränkt: ohne_erschliessung = Ablage in WLO ohne Kestra-Metadaten."
              },
              "grund_erschliessung": {
                "enum": [
                  "flow_nicht_freigegeben",
                  "dienst_nicht_erreichbar"
                ],
                "description": "Nur mit hinweis ohne_erschliessung: warum WLO gerade keine Metadaten erzeugt. flow_nicht_freigegeben: der Metadaten-Flow ist nicht freigegeben; dienst_nicht_erreichbar: der Dienst, der ihn startet, ist nicht erreichbar."
              },
              "ueber_grenze": {
                "enum": [
                  "ueber_grenze",
                  "ueber_grenze_anmelden"
                ],
                "description": "Nur chat: dieser Code gilt, wenn die Auswahl die Grenzen lokal_* überschreitet (dann nur namen bzw. wlo); _anmelden = mit WLO-Anmeldung ginge alles über WLO."
              }
            }
          },
          "namen": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geht"
            ],
            "description": "Nur Namen senden, nichts hochladen.",
            "properties": {
              "geht": {
                "type": "boolean",
                "description": "Ist der Ort wählbar."
              },
              "grund": {
                "enum": [
                  "aus",
                  "nur_angemeldet",
                  "ablauf"
                ],
                "description": "Warum gesperrt: aus (Studio oder Dienst fehlt), nur_angemeldet (geht nach der WLO-Anmeldung), ablauf (der Ablauf lässt ihn nicht zu)."
              },
              "hinweis": {
                "enum": [
                  "ohne_erschliessung"
                ],
                "description": "Geht, aber eingeschränkt: ohne_erschliessung = Ablage in WLO ohne Kestra-Metadaten."
              },
              "ueber_grenze": {
                "enum": [
                  "ueber_grenze",
                  "ueber_grenze_anmelden"
                ],
                "description": "Nur chat: dieser Code gilt, wenn die Auswahl die Grenzen lokal_* überschreitet (dann nur namen bzw. wlo); _anmelden = mit WLO-Anmeldung ginge alles über WLO."
              }
            }
          }
        }
      }
    }
  },
