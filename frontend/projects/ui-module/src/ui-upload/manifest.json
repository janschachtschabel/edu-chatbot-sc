          }
        }
      },
      "datei": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "i",
          "endung",
          "groesse",
          "rolle"
        ],
        "properties": {
          "i": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4999,
            "description": "Feste Nummer der Datei in der Auswahl (dieselbe bei der Ablage in WLO)."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\n\r]*$",
            "description": "Dateiname (eine Zeile, hoechstens 120 Zeichen); fehlt bei Rolle ignorieren."
          },
          "endung": {
            "type": "string",
            "maxLength": 10,
            "pattern": "^[a-z0-9]*$",
            "description": "Endung, kleingeschrieben; leer ohne Endung."
          },
          "groesse": {
            "type": "integer",
            "minimum": 0,
            "description": "Groesse in Bytes."
          },
          "rolle": {
            "enum": [
              "inhalt",
              "struktur",
              "ignorieren"
            ],
            "description": "Rolle der Datei in der Auswahl."
          }
        },
        "if": {
          "properties": {
            "rolle": {
              "const": "ignorieren"
            }
          }
        },
        "then": {
          "not": {
            "required": [
              "name"
            ]
          }
        },
        "else": {
          "required": [
            "name"
          ]
        }
      }
    },
    "properties": {
      "aktion": {
        "enum": [
          "erfasst",
          "dokument",
          "uebertragen"
        ],
        "description": "erfasst: der Befund (Ordner und Zahlen); dokument: die markierten Dokumente wurden gelesen (Feld dokument, bei mehreren dazu dokumente); uebertragen: die Dateien wurden in den persoenlichen Bereich in WLO uebertragen (Feld ablage). Kein Ziel: was damit geschieht, entscheiden die naechsten Schritte."
      },
      "struktur": {
        "$ref": "#/$defs/ordner1",
        "description": "Der erfasste Ordnerbaum (Wurzel + höchstens 8 Ebenen, höchstens 500 Ordner), je Ordner mit seinen Dateien."
      },
      "zahlen": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordner",
          "dateien",
          "inhalte",
          "ignoriert",
          "strukturdokumente",
          "bytes"
        ],
        "description": "Zahlen der Erfassung.",
        "properties": {
          "ordner": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Zahl der Ordner."
          },
          "dateien": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Alle erfassten Dateien."
          },
          "inhalte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Dateien mit der Rolle Inhalt."
          },
          "ignoriert": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Ignorierte Dateien."
          },
          "strukturdokumente": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "Markierte Strukturdokumente (hoechstens fuenf)."
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Groesse aller nicht ignorierten Dateien."
          }
        }
      },
      "strukturdokument": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "groesse",
              "endung"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^\\n\\r]*$",
                "description": "Dateiname des Strukturdokuments."
              },
              "groesse": {
                "type": "integer",
                "minimum": 0,
                "description": "Groesse in Bytes."
              },
              "endung": {
                "enum": [
                  "pdf",
                  "docx",
                  "txt",
                  "md"
                ],
                "description": "Dateiendung."
              }
            }
          }
        ],
        "description": "Das erste markierte Strukturdokument oder null (alle markierten stehen mit Rolle struktur in dateiliste)."
      },
      "warnungen": {
        "type": "array",
        "maxItems": 7,
        "items": {
          "enum": [
            "zu_viele",
            "zu_tief",
            "zu_gross",
            "leer",
            "ungueltiger_pfad",
            "zu_viele_ordner",
            "namen_gekuerzt"
          ]
        },
        "description": "Was beim Erfassen weggefallen ist."
      },
      "dokument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upload_id",
          "name",
          "format",
          "befund",
          "vorschau"
        ],
        "description": "Nur mit aktion dokument: was das System beim Lesen festgestellt hat (kein Text des Dokuments); bei mehreren das erste aus dokumente.",
        "properties": {
          "upload_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "Kennung des gelesenen Dokuments (POST /api/ui/dokumente)."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\n\r]*$",
            "description": "Name des Dokuments."
          },
          "format": {
            "enum": [
              "pdf",
              "docx",
              "txt",
              "md"
            ],
            "description": "Erkannte Art."
          },
          "befund": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seiten",
              "woerter",
              "abschnitte",
              "gliederung_art",
              "warnungen"
            ],
            "properties": {
              "seiten": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                ],
                "description": "Seiten (nur PDF)."
              },
              "woerter": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000,
                "description": "Woerter."
              },
              "abschnitte": {
                "type": "integer",
                "minimum": 0,
                "maximum": 400,
                "description": "Abschnitte der Gliederung."
              },
              "gliederung_art": {
                "enum": [
                  "ueberschriften",
                  "nummeriert",
                  "teile"
                ],
                "description": "Woran gegliedert wurde."
              },
              "warnungen": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "enum": [
                    "bilder_entfernt",
                    "wenig_text",
                    "keine_gliederung",
                    "gekuerzt"
                  ]
                },
                "description": "Hinweise beim Lesen."
              }
            }
          },
