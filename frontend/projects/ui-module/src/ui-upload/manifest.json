{
  "name": "ui_upload",
  "version": 1,
  "art": "abfragen",
  "titel": {
    "de": "Ordner und Dateien",
    "en": "Folders and files"
  },
  "beschreibung": "Laesst die Person einen Ordner (oder einzelne Dateien) auswaehlen oder ablegen und zeigt ihn als Baum mit Dateizahlen. Erfasst wird nur im Browser, hochgeladen wird nichts. Die Person kann Dateien ignorieren und ein Strukturdokument (z. B. einen Lehrplan) markieren, danach den Befund schicken oder die Ordnerstruktur als Themenbaum-Entwurf uebernehmen. Zurueck kommen nur Ordnernamen und Zahlen, keine Dateinamen.",
  "wann": [
    "die Person hat Materialien in Ordnern und will daraus eine Sammlungsstruktur oder einen Themenbaum machen",
    "die Person will einen Ordner mit Dateien einbringen, sichten oder ordnen",
    "die Person fragt, ob sie Dateien oder einen Ordner hochladen kann",
    "die Person will aus ihrem Lehrplan oder Strukturdokument eine Struktur machen (Lehrplan einbringen)"
  ],
  "nicht_wann": [
    "ein Thema ohne eigene Dateien gliedern (dafuer ui_strukturentwurf)",
    "zeigen, was es in WLO schon gibt (dafuer ui_themenbaum)",
    "ein einzelnes Bild ansehen oder beschreiben lassen"
  ],
  "agent": true,
  "laden": "bei_bedarf",
  "dienst": {
    "name": "upload_angebot",
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zweck"
      ],
      "properties": {
        "zweck": {
          "enum": [
            "sammlungsstruktur"
          ],
          "description": "sammlungsstruktur: Ordner erfassen, um daraus eine Sammlungsstruktur bzw. einen Themenbaum zu machen."
        },
        "hinweis": {
          "type": "string",
          "maxLength": 300,
          "description": "Kurzer Satz an die Person, was sie auswaehlen soll (z. B. 'Waehle den Ordner mit deinen Physik-Materialien.')."
        },
        "einzeldatei_als_struktur": {
          "type": "boolean",
          "description": "Eine einzeln gewaehlte Datei (PDF, Word, Text, Markdown) gleich als Strukturdokument vormerken — fuer den Ablauf 'Themenbaum aus einem Dokument'. Sonst bleibt sie Inhalt."
        }
      }
    }
  },
  "eingabe": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "zweck"
    ],
    "properties": {
      "zweck": {
        "enum": [
          "sammlungsstruktur"
        ],
        "description": "Wozu erfasst wird."
      },
      "hinweis": {
        "type": "string",
        "maxLength": 300,
        "description": "Satz an die Person ueber dem Auswahlfeld."
      },
      "grenzen": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "description": "Grenzen fuer das Erfassen (setzt das System).",
        "properties": {
          "max_dateien": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "description": "Hoechstzahl erfasster Dateien."
          },
          "max_tiefe": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Hoechste Ordnertiefe."
          },
          "max_mb_datei": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Groesste Datei in MB."
          },
          "max_mb_ablage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Groesste Datei in MB fuer die Ablage in WLO."
          }
        }
      },
      "schalter": {
        "type": "object",
        "x-nur-system": true,
        "additionalProperties": false,
        "description": "Was im Studio eingeschaltet ist (setzt das System).",
        "properties": {
          "dokument_im_chat": {
            "type": "boolean",
            "description": "Darf ein Dokument im Chat gelesen werden."
          },
          "ablage_in_wlo": {
            "type": "boolean",
            "description": "Duerfen Inhalte in WLO abgelegt werden."
          }
        }
      },
      "einzeldatei_als_struktur": {
        "type": "boolean",
        "description": "Eine einzeln gewaehlte Datei (PDF, Word, Text, Markdown) gleich als Strukturdokument vormerken — fuer den Ablauf 'Themenbaum aus einem Dokument'. Sonst bleibt sie Inhalt."
      }
    }
  },
  "antwort": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "aktion",
      "struktur",
      "zahlen",
      "strukturdokument",
      "warnungen"
    ],
    "$defs": {
      "ordner1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "dateien",
          "alle_dateien",
          "kinder"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\n\\r]*$",
            "description": "Ordnername (leer bei der Auswahl mehrerer Ordner)."
          },
          "dateien": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Dateien direkt in diesem Ordner."
          },
          "alle_dateien": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Dateien samt Unterordnern."
