            "kinder": [
              {
                "id": "k1-1", "titel": "Anteile darstellen",
                "kinder": [ { "id": "k1-1-1", "titel": "Kreis- und Rechteckmodelle" }, { "id": "k1-1-2", "titel": "Zahlenstrahl" } ]
              }
            ]
          },
          { "id": "k2", "titel": "Mit Bruechen rechnen", "kinder": [ { "id": "k2-1", "titel": "Addieren" }, { "id": "k2-2", "titel": "Multiplizieren" } ] }
        ]
      }
    }
  ]
}
