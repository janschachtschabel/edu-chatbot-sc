{
  "name": "boerdi-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve widget --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build widget",
    "build:widget": "ng run widget:build-widget",
    "build:studio": "ng build studio",
    "start:studio": "ng serve studio --port 4300 --proxy-config proxy.conf.json",
    "lint": "eslint .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:a11y": "node scripts/check-a11y-structure.mjs",
    "check:radii": "node scripts/check-radii.mjs",
    "test": "ng test ui && ng test widget && ng test studio",
    "licenses": "license-checker-rseidelsohn --production --summary --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;0BSD;BSD-2-Clause;BSD-3-Clause;ISC;(MPL-2.0 OR Apache-2.0)\"",
    "budget": "npm run build:widget && node scripts/check-widget-budget.mjs",
    "e2e": "npm run build:widget && playwright test"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/elements": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.13",
    "marked": "^12.0.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.6",
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.19",
    "@playwright/test": "^1.62.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  }
}
